# Copy this file to .env and fill in your values
# Never commit .env to Git

# Option A — single connection string (Render injects this automatically)
DATABASE_URL=postgresql://rxsmart:your_password@host:5432/rxsmart

# Option B — individual fields (local dev fallback)
DB_HOST=localhost
DB_USER=rxsmart
DB_PASSWORD=your_password_here
DB_NAME=rxsmart
DB_PORT=5432

FLASK_ENV=development
PORT=5000
